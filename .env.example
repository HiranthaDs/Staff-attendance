NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_server_only_secret_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local migration runner only. Keep this in .env.local and never expose it to
# the browser or commit the real value.
# SUPABASE_DB_PASSWORD=your_database_password
# SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres.your_project_ref

# Only enable forwarded headers when the Next.js origin is reachable exclusively
# through that trusted proxy. Vercel is detected automatically with VERCEL=1.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=1
# TRUSTED_PROXY_PROVIDER=cloudflare

# Optional for a localhost server and browser sharing the same office internet.
LOCAL_ATTENDANCE_EGRESS_FALLBACK=false
