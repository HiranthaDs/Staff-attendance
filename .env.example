NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_server_only_secret_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Welcome/password-reset emails (Resend)
RESEND_API_KEY=re_your_server_only_key
EMAIL_FROM=Presence <attendance@your-domain.com>

# Web Push notifications. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_vapid_key
VAPID_PRIVATE_KEY=your_private_vapid_key
VAPID_SUBJECT=mailto:admin@your-domain.com

# Protects the scheduled attendance-reminder endpoint. Vercel sends this as
# an Authorization bearer token for configured cron jobs.
CRON_SECRET=replace_with_a_long_random_secret

# Local migration runner only. Keep this in .env.local and never expose it to
# the browser or commit the real value.
# SUPABASE_DB_PASSWORD=your_database_password
# SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres.your_project_ref
